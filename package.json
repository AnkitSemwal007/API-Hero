    "menus": {
      "commandPalette": [
        {
          "command": "apiRunner.login",
          "when": "false"
        },
        {
          "command": "apiRunner.logout",
          "when": "false"
        },
        {
          "command": "apiRunner.runFile",
          "when": "false"
        },
        {
          "command": "apiRunner.recentRequests",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "apiRunner.runRequest",
          "when": "resourceLangId == api",
          "group": "navigation@1"
        },
        {
          "command": "apiRunner.openRequestEditor",
          "when": "resourceLangId == api && !activeCustomEditorId",
          "group": "1_more@1"
        },
        {
          "command": "apiRunner.switchEnvironment",
          "when": "resourceLangId == api",
          "group": "1_more@2"
        },
        {
          "command": "apiRunner.selectAuthentication",
          "when": "resourceLangId == api",
          "group": "1_more@3"
        }
      ],
      "editor/context": [
        {
          "command": "apiRunner.runRequest",
          "when": "(editorLangId == api && editorTextFocus) || activeCustomEditorId == 'apiRunner.requestEditor'",
          "group": "navigation@10"
        },
        {
          "command": "apiRunner.revealActiveRequest",
          "when": "(editorLangId == api && editorTextFocus) || activeCustomEditorId == 'apiRunner.requestEditor'",
          "group": "navigation@11"
        }
      ],
