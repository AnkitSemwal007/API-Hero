          "id": "apiRunner",
          "title": "API Hero",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "apiRunner": [
        {
          "id": "apiRunner.collections",
          "name": "Collections"
        },
        {
          "id": "apiRunner.history",
          "name": "History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apiRunner.collections",
        "contents": "No collections yet.\nOpen a folder workspace, create a collection, then add a request — or import OpenAPI.\n\n[New Collection](command:apiRunner.createCollection)\n[New Request](command:apiRunner.createRequest)\n[Import OpenAPI](command:apiRunner.importOpenApi)\n\n[Open Overview](command:apiRunner.openOverview)"
      },
      {
        "view": "apiRunner.history",
        "contents": "No request history yet.\nAfter you Run a request, results appear here.\n\n[Focus Collections](command:apiRunner.focusCollections)\n[Open Overview](command:apiRunner.openOverview)"
      }
    ],
    "keybindings": [
      {
        "command": "apiRunner.runRequest",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "(editorLangId == api && editorTextFocus) || activeCustomEditorId == 'apiRunner.requestEditor'"
      },
      {
        "command": "apiRunner.renameCollection",
        "key": "f2",
        "when": "focusedView == apiRunner.collections && viewItem == collection"
      },
      {
        "command": "apiRunner.renameFolder",
        "key": "f2",
        "when": "focusedView == apiRunner.collections && viewItem == folder"
      },
      {
        "command": "apiRunner.renameRequest",
        "key": "f2",
        "when": "focusedView == apiRunner.collections && viewItem == request"
      },
      {
        "command": "apiRunner.deleteCollection",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == apiRunner.collections && viewItem == collection"
      },
      {
        "command": "apiRunner.deleteFolder",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == apiRunner.collections && viewItem == folder"
      },
      {
        "command": "apiRunner.deleteRequest",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == apiRunner.collections && viewItem =~ /^request/"
      }
    ],
    "configuration": {
      "title": "API Hero",
      "properties": {
        "apiRunner.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "default": "info",
          "description": "Minimum severity written to the API Hero output channel."
        },
        "apiRunner.requestTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 0,
          "description": "Default HTTP request timeout in milliseconds. Set to 0 to disable the timeout. Per-request @timeout overrides this default when present."
        },
        "apiRunner.maxResponseBytes": {
          "type": "number",
          "default": 10485760,
          "minimum": 0,
          "description": "Maximum buffered HTTP response body size in bytes. When exceeded during download, the request fails with RESPONSE_TOO_LARGE. Set to 0 for no limit."
        },
        "apiRunner.history.maxEntries": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum number of request history entries to retain. Newest entries are kept when the limit is exceeded."
        },
        "apiRunner.variables.global": {
          "type": "array",
          "default": [],
          "description": "Global API Hero variables (User settings). Sensitive values are masked in language and response UI; prefer Secret Storage for credentials via Manage Authentication.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "value": {
                "type": "string"
              },
              "sensitive": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "apiRunner.variables.workspace": {
          "type": "array",
          "default": [],
          "description": "Workspace API Hero variables. Do not commit secrets in workspace settings; use Manage Authentication / Secret Storage for credentials.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "value": {
                "type": "string"
              },
              "sensitive": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "apiRunner.environments": {
          "type": "array",
          "default": [],
          "description": "Named API Hero environments (id, name, variables). Prefer Manage Environments for day-to-day edits. At most one environment is active via apiRunner.activeEnvironment.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "variables"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "variables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                    },
                    "value": {
                      "type": "string"
                    },
                    "sensitive": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "additionalProperties": false
                }
