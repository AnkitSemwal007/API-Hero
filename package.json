{
  "name": "api-hero",
  "displayName": "API Hero",
  "description": "Git-first REST/HTTP client for VS Code. Edit .api requests in a UI Request Editor, run with assertions, manage collections, environments, and auth, import OpenAPI, and inspect History and Run Reports.",
  "version": "2.3.0",
  "publisher": "ankitsemwal",
  "license": "MIT",
  "homepage": "https://github.com/AnkitSemwal007/API-Hero",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnkitSemwal007/API-Hero.git"
  },
  "bugs": {
    "url": "https://github.com/AnkitSemwal007/API-Hero/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Programming Languages"
  ],
  "keywords": [
    "api hero",
    "rest client",
    "http client",
    "api client",
    "api testing",
    "openapi",
    "openapi 3",
    "api collections",
    "collection runner",
    "http requests",
    "http file",
    ".api",
    "assertions",
    "git",
    "http",
    "rest",
    "api",
    "vscode"
  ],
  "galleryBanner": {
    "color": "#0f766e",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "api",
        "aliases": [
          "API Hero",
          "api"
        ],
        "extensions": [
          ".api"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/api-light.svg",
          "dark": "./images/api-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "api",
        "scopeName": "source.api-runner",
        "path": "./syntaxes/api.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "api",
        "path": "./snippets/api.json"
      }
    ],
    "commands": [
