    "check": "tsc -p ./ --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run compile && node ./scripts/run-unit-tests.mjs",
    "test:unit": "npm test",
    "test:coverage": "npm run compile && c8 --reporter=text-summary --reporter=text node ./scripts/run-unit-tests.mjs",
    "package": "npm run clean && npm run build && npm test && node ./scripts/package-vsix.mjs",
    "package:fast": "npm run build && node ./scripts/package-vsix.mjs",
    "vscode:prepublish": "npm run compile"
