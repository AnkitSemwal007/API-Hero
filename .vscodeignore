# VCS / editor / agent
.git/**
.github/**
.vscode/**
.cursor/**
.cursorrules
.cursor-phase1-progress.json
.cursor*.json
.cursor-fix/**
_write_tmp/**
_fix*.py
_keep*.py
.gitignore

# Source & build tooling (runtime is dist/)
src/**
scripts/**
tsconfig.json
eslint.config.mjs
package-lock.json

# Accidental/extraneous packages — never ship (not in package.json)
node_modules/esbuild/**
node_modules/@esbuild/**

# Tests & coverage
coverage/**
.nyc_output/**
**/*.test.js
**/*.test.d.ts
**/__tests__/**

# Source maps & TypeScript (ship compiled JS only)
**/*.map
**/*.ts

# Docs / examples not required on Marketplace
docs/**
examples/**
RELEASE.md
CONTRIBUTING.md

# Release artifacts, logs, temp, backups, design sources
release/**
*.vsix
*.bundle
*.tmp
*.bak
*.old
*.orig
**/*.log
**/*.psd
**/*.fig
**/.DS_Store
**/Thumbs.db
tmp/**
temp/**

# Extension chrome icons must ship (icon.png, api-*.svg, execution-*.svg).
# Listing screenshots / banner / workflow / MCP GIFs are Cloudinary CDN URLs in README —
# never package them (keeps the VSIX small).
images/marketplace/**
**/*.gif
**/screenshot-*.png
**/social-preview*.png
**/workflow-hero*.png
**/banner.png
**/hero.png
