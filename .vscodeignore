# VCS / editor / agent
.git/**
.github/**
.vscode/**
.cursor/**
.cursorrules
.cursor-phase1-progress.json
.cursor*.json
.cursor-fix/**
_write_tmp/**
_fix*.py
_keep*.py
.gitignore

# Source & build tooling (runtime is bundled dist/ entry points)
src/**
scripts/**
tsconfig.json
eslint.config.mjs
package-lock.json

# Production deps are inlined into esbuild bundles (extension / MCP / CLI).
# Do not ship node_modules sprawl (MCP SDK transitive tree, etc.).
node_modules/**

# After `npm run bundle`, only the three entry bundles are needed at runtime.
# Keep tsc multi-file dist/ for local test/dev; exclude it from the VSIX.
dist/**
!dist/extension.js
!dist/mcp/
!dist/mcp/server.js
!dist/cli/
!dist/cli/main.js

# Tests & coverage
coverage/**
.nyc_output/**
**/*.test.js
**/*.test.d.ts
**/__tests__/**

# Source maps & TypeScript (ship bundled JS only)
**/*.map
**/*.ts
**/*.d.ts

# Docs / examples not required on Marketplace
docs/**
examples/**
RELEASE.md
CONTRIBUTING.md

# Release artifacts, logs, temp, backups, design sources
release/**
*.vsix
*.bundle
*.tmp
*.bak
*.old
*.orig
**/*.log
**/*.psd
**/*.fig
**/.DS_Store
**/Thumbs.db
tmp/**
temp/**
tmp-*.txt
tmp-mcp-*

# Extension chrome icons must ship (icon.png, api-*.svg, execution-*.svg).
# Listing screenshots / banner / workflow / MCP GIFs are Cloudinary CDN URLs in README —
# never package them (keeps the VSIX small).
images/marketplace/**
**/*.gif
**/screenshot-*.png
**/social-preview*.png
**/workflow-hero*.png
**/banner.png
**/hero.png
