@name Add Post
@description Simulate creating a post (server does not persist).

POST {{baseUrl}}/posts/add
Accept: application/json
Content-Type: application/json

{
  "title": "Exploring DummyJSON with API Hero",
  "body": "This sample post demonstrates a realistic JSON create body.",
  "userId": 5,
  "tags": [
    "api",
    "demo"
  ]
}
expect status == 200
expect body.id exists
